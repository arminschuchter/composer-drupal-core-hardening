{
  "name": "marchmol/composer-drupal-core-hardening",
  "description": "Hardens the drupal core directory for when it's in the docroot.",
  "keywords": ["drupal", "hardening"],
  "homepage": "https://www.drupal.org/project/drupal",
  "license": "GPL-2.0-or-later",
  "type": "composer-plugin",
  "autoload": {
    "psr-4": {
      "MarchMol\\Composer\\Plugin\\DrupalCoreHardening\\": "."
    }
  },
  "extra": {
    "class": "MarchMol\\Composer\\Plugin\\DrupalCoreHardening\\DrupalCoreHardeningPlugin"
  },
  "require": {
    "php": ">=7.3.0",
    "composer-plugin-api": "^2"
  }
}
